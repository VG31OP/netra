import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView, ListView, CheckBox } from "std-widgets.slint";

export struct PacketItem {
    index: int,
    protocol: string,
    source: string,
    destination: string,
    length: int,
    summary: string,
    bg_color: color,
    fg_color: color,
}

export struct DissectedLayerItem {
    name: string,
    detail: string,
}

export struct ScannedPortItem {
    port: string,
    state: string,
    service: string,
    version: string,
}

export struct HostItem {
    ip: string,
    mac: string,
    os: string,
    services: string,
    packets: int,
}

export struct ConversationItem {
    endpoint_a: string,
    endpoint_b: string,
    packets: int,
    bytes: int,
}

export struct ProtocolStatItem {
    protocol: string,
    packets: int,
}

export struct ExpertItem {
    packet_index: int,
    severity: string,
    group: string,
    protocol: string,
    message: string,
}

export struct TracerouteItem {
    hop: int,
    ip: string,
    rtt: string,
    status: string,
}

export struct VulnItem {
    id: string,
    title: string,
    severity: string,
    port: string,
    description: string,
    remediation: string,
}

export component MainWindow inherits Window {
    title: "NETRA - Unified Network Intelligence, Packet Dissection & Scanning Platform";
    preferred-width: 1240px;
    preferred-height: 820px;
    background: #0d1117;
    default-font-family: "Segoe UI, sans-serif";

    in-out property <string> active-nav: "packets";
    in-out property <string> storage-mode: "Portable Mode (Active)";
    in-out property <string> status-message: "NETRA Core Online | Ready";
    in-out property <int> known-hosts-count: 0;
    in-out property <int> total-packets-count: 0;
    in-out property <int> open-ports-count: 0;

    // Filter & Scanner
    in-out property <string> filter-input: "";
    in-out property <string> target-input: "127.0.0.1";
    in-out property <string> ports-input: "top-100";
    in-out property <int> timing-level: 3;
    in-out property <int> selected-packet-index: 1;
    in-out property <string> hexdump-content: "Select a packet in the table above to view raw bytes.";
    in-out property <string> os-match-text: "No scan executed yet. Start an Nmap scan to detect OS & services.";

    // Data lists
    in-out property <[PacketItem]> packet-list: [];
    in-out property <[DissectedLayerItem]> layer-list: [];
    in-out property <[ScannedPortItem]> scan-results: [];
    in-out property <[HostItem]> host-list: [];
    in-out property <[ConversationItem]> conversation-list: [];
    in-out property <[ProtocolStatItem]> protocol-stats: [];

    // Expert Info
    in-out property <[ExpertItem]> expert-list: [];
    in-out property <int> expert-errors-count: 0;
    in-out property <int> expert-warns-count: 0;
    in-out property <int> expert-notes-count: 0;

    // Traceroute
    in-out property <string> traceroute-target: "127.0.0.1";
    in-out property <[TracerouteItem]> traceroute-list: [];

    // Vulnerability Audit (NSE)
    in-out property <string> audit-target: "127.0.0.1";
    in-out property <[VulnItem]> vuln-list: [];
    in-out property <int> vulns-count: 0;

    // Settings
    in-out property <bool> setting-offline: true;
    in-out property <bool> setting-checksum: true;
    in-out property <bool> setting-relative-seq: true;
    in-out property <bool> setting-tcp-reassembly: true;
    in-out property <bool> setting-desegment-ssl: true;
    in-out property <bool> setting-audit-ciphers: true;
    in-out property <bool> setting-audit-anon-ftp: true;
    in-out property <bool> setting-audit-smb: true;
    in-out property <string> setting-time-format: "Relative Time";
    in-out property <string> setting-scan-type: "TCP Connect (-sT)";
    in-out property <string> setting-snaplen: "65535";

    // Callbacks
    callback nav-changed(string);
    callback load-capture-file();
    callback apply-filter(string);
    callback select-packet(int);
    callback run-scan(string, string, int);
    callback run-discovery(string);
    callback refresh-stats();
    callback load-expert-info();
    callback run-traceroute(string);
    callback run-audit(string);
    callback save-settings();

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        // Top Navigation Bar
        Rectangle {
            height: 56px;
            background: #161b22;
            HorizontalBox {
                padding-left: 20px;
                padding-right: 20px;
                alignment: space-between;

                HorizontalBox {
                    spacing: 14px;
                    Text {
                        text: "NETRA";
                        font-size: 20px;
                        font-weight: 800;
                        color: #58a6ff;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "|  Wireshark Dissection + Nmap Intelligence Engine (Rust)";
                        font-size: 13px;
                        color: #8b949e;
                        vertical-alignment: center;
                    }
                }

                HorizontalBox {
                    spacing: 12px;
                    Rectangle {
                        background: #1f2937;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #238636;
                        height: 28px;
                        HorizontalBox {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: root.storage-mode;
                                color: #3fb950;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Main Layout
        HorizontalBox {
            padding: 0px;
            spacing: 0px;

            // Sidebar
            Rectangle {
                width: 220px;
                background: #0d1117;
                border-width: 1px;
                border-color: #30363d;

                VerticalBox {
                    padding: 12px;
                    spacing: 6px;
                    alignment: start;

                    Button {
                        text: "  Packet Analyzer";
                        clicked => { root.active-nav = "packets"; root.nav-changed("packets"); }
                    }
                    Button {
                        text: "  Expert Info";
                        clicked => { root.active-nav = "expert"; root.load-expert-info(); }
                    }
                    Button {
                        text: "  Nmap Scanner";
                        clicked => { root.active-nav = "scanner"; root.nav-changed("scanner"); }
                    }
                    Button {
                        text: "  Traceroute";
                        clicked => { root.active-nav = "traceroute"; }
                    }
                    Button {
                        text: "  Security Audit (NSE)";
                        clicked => { root.active-nav = "audit"; }
                    }
                    Button {
                        text: "  Network Inventory";
                        clicked => { root.active-nav = "inventory"; root.nav-changed("inventory"); }
                    }
                    Button {
                        text: "  Traffic Statistics";
                        clicked => { root.active-nav = "stats"; root.refresh-stats(); }
                    }
                    Button {
                        text: "  Overview Dashboard";
                        clicked => { root.active-nav = "overview"; root.nav-changed("overview"); }
                    }
                    Button {
                        text: "  Settings & Config";
                        clicked => { root.active-nav = "settings"; }
                    }
                }
            }

            // Content Body Area
            Rectangle {
                background: #090d13;
                VerticalBox {
                    padding: 14px;
                    spacing: 10px;

                    // ==============================================================
                    // 1. WIRESHARK 3-PANE PACKET ANALYZER
                    // ==============================================================
                    if root.active-nav == "packets": VerticalBox {
                        spacing: 8px;

                        // Display Filter Bar
                        HorizontalBox {
                            spacing: 8px;
                            height: 34px;
                            LineEdit {
                                placeholder-text: "Apply Wireshark display filter ... (e.g. tcp.port == 80, http, dns, ip.src == 192.168.1.1)";
                                text <=> root.filter-input;
                                accepted => { root.apply-filter(root.filter-input); }
                            }
                            Button {
                                text: "Apply";
                                clicked => { root.apply-filter(root.filter-input); }
                            }
                            Button {
                                text: "Clear";
                                clicked => { root.filter-input = ""; root.apply-filter(""); }
                            }
                            Button {
                                text: "Load Sample";
                                clicked => { root.load-capture-file(); }
                            }
                        }

                        // PANE 1: Top Packet List Table (with Wireshark Color-Coding)
                        Rectangle {
                            background: #161b22;
                            border-radius: 4px;
                            border-color: #30363d;
                            border-width: 1px;
                            height: 250px;

                            VerticalBox {
                                padding: 6px;
                                spacing: 2px;
                                HorizontalBox {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    height: 20px;
                                    Text { text: "No."; width: 45px; font-size: 11px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Protocol"; width: 75px; font-size: 11px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Source"; width: 140px; font-size: 11px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Destination"; width: 140px; font-size: 11px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Length"; width: 60px; font-size: 11px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Info / Dissected Summary"; font-size: 11px; font-weight: 700; color: #8b949e; }
                                }
                                Rectangle { height: 1px; background: #30363d; }
                                ListView {
                                    for item in root.packet-list: Rectangle {
                                        height: 24px;
                                        background: item.index == root.selected-packet-index ? #21262d : item.bg_color;
                                        border-radius: 2px;
                                        TouchArea {
                                            clicked => {
                                                root.selected-packet-index = item.index;
                                                root.select-packet(item.index);
                                            }
                                        }
                                        HorizontalBox {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            Text { text: item.index; width: 45px; font-size: 11px; color: #8b949e; vertical-alignment: center; }
                                            Text { text: item.protocol; width: 75px; font-size: 11px; font-weight: 700; color: item.fg_color; vertical-alignment: center; }
                                            Text { text: item.source; width: 140px; font-size: 11px; color: #f0f6fc; vertical-alignment: center; }
                                            Text { text: item.destination; width: 140px; font-size: 11px; color: #f0f6fc; vertical-alignment: center; }
                                            Text { text: item.length; width: 60px; font-size: 11px; color: #8b949e; vertical-alignment: center; }
                                            Text { text: item.summary; font-size: 11px; color: item.fg_color; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }
                        }

                        // Split PANE 2 (Tree) + PANE 3 (Hex Dump)
                        HorizontalBox {
                            spacing: 8px;

                            // PANE 2: Packet Details Tree
                            Rectangle {
                                width: 480px;
                                height: 260px;
                                background: #161b22;
                                border-radius: 4px;
                                border-color: #30363d;
                                border-width: 1px;
                                VerticalBox {
                                    padding: 8px;
                                    spacing: 4px;
                                    Text {
                                        text: "▸ Packet Protocol Dissection Tree";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #58a6ff;
                                    }
                                    Rectangle { height: 1px; background: #30363d; }
                                    ListView {
                                        for layer in root.layer-list: VerticalBox {
                                            padding-top: 3px;
                                            padding-bottom: 3px;
                                            spacing: 1px;
                                            Text {
                                                text: "▸ " + layer.name;
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: #79c0ff;
                                            }
                                            Text {
                                                text: "   " + layer.detail;
                                                font-size: 11px;
                                                color: #c9d1d9;
                                            }
                                        }
                                    }
                                }
                            }

                            // PANE 3: Hex & ASCII Dump View
                            Rectangle {
                                height: 260px;
                                background: #161b22;
                                border-radius: 4px;
                                border-color: #30363d;
                                border-width: 1px;
                                VerticalBox {
                                    padding: 8px;
                                    spacing: 4px;
                                    Text {
                                        text: "▸ Frame Hex & ASCII Byte Representation";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #3fb950;
                                    }
                                    Rectangle { height: 1px; background: #30363d; }
                                    ScrollView {
                                        Text {
                                            text: root.hexdump-content;
                                            font-family: "Consolas, Courier New, monospace";
                                            font-size: 11px;
                                            color: #c9d1d9;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ==============================================================
                    // 2. WIRESHARK EXPERT INFO TAB
                    // ==============================================================
                    if root.active-nav == "expert": VerticalBox {
                        spacing: 10px;
                        Text { text: "Wireshark Expert Information & Protocol Health"; font-size: 18px; font-weight: 700; color: #f0f6fc; }

                        HorizontalBox {
                            spacing: 12px;
                            Rectangle {
                                background: #161b22;
                                border-radius: 6px;
                                border-color: #30363d;
                                border-width: 1px;
                                height: 75px;
                                VerticalBox {
                                    padding: 10px;
                                    Text { text: "ERRORS"; font-size: 11px; color: #ff7b72; font-weight: 700; }
                                    Text { text: root.expert-errors-count; font-size: 22px; font-weight: 700; color: #ff7b72; }
                                }
                            }
                            Rectangle {
                                background: #161b22;
                                border-radius: 6px;
                                border-color: #30363d;
                                border-width: 1px;
                                height: 75px;
                                VerticalBox {
                                    padding: 10px;
                                    Text { text: "WARNINGS"; font-size: 11px; color: #d29922; font-weight: 700; }
                                    Text { text: root.expert-warns-count; font-size: 22px; font-weight: 700; color: #d29922; }
                                }
                            }
                            Rectangle {
                                background: #161b22;
                                border-radius: 6px;
                                border-color: #30363d;
                                border-width: 1px;
                                height: 75px;
                                VerticalBox {
                                    padding: 10px;
                                    Text { text: "NOTES & CHATS"; font-size: 11px; color: #58a6ff; font-weight: 700; }
                                    Text { text: root.expert-notes-count; font-size: 22px; font-weight: 700; color: #58a6ff; }
                                }
                            }
                        }

                        Rectangle {
                            background: #161b22;
                            border-radius: 6px;
                            border-color: #30363d;
                            border-width: 1px;
                            height: 440px;

                            VerticalBox {
                                padding: 12px;
                                spacing: 6px;
                                HorizontalBox {
                                    Text { text: "Pkt #"; width: 60px; font-size: 12px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Severity"; width: 90px; font-size: 12px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Group"; width: 120px; font-size: 12px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Protocol"; width: 80px; font-size: 12px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Expert Summary & Message"; font-size: 12px; font-weight: 700; color: #8b949e; }
                                }
                                Rectangle { height: 1px; background: #30363d; }
                                ListView {
                                    for alert in root.expert-list: HorizontalBox {
                                        height: 28px;
                                        Text { text: alert.packet_index; width: 60px; font-size: 12px; color: #8b949e; vertical-alignment: center; }
                                        Text { text: alert.severity; width: 90px; font-size: 12px; font-weight: 700; color: alert.severity == "Error" ? #ff7b72 : (alert.severity == "Warning" ? #d29922 : #58a6ff); vertical-alignment: center; }
                                        Text { text: alert.group; width: 120px; font-size: 12px; color: #f0f6fc; vertical-alignment: center; }
                                        Text { text: alert.protocol; width: 80px; font-size: 12px; color: #79c0ff; vertical-alignment: center; }
                                        Text { text: alert.message; font-size: 12px; color: #c9d1d9; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }

                    // ==============================================================
                    // 3. NMAP NETWORK SCANNER TAB
                    // ==============================================================
                    if root.active-nav == "scanner": VerticalBox {
                        spacing: 10px;

                        // Configuration Row
                        Rectangle {
                            background: #161b22;
                            border-radius: 6px;
                            border-color: #30363d;
                            border-width: 1px;

                            VerticalBox {
                                padding: 10px;
                                spacing: 8px;
                                HorizontalBox {
                                    spacing: 10px;
                                    VerticalBox {
                                        spacing: 3px;
                                        Text { text: "Target (IP, Subnet, Hostname):"; font-size: 11px; color: #8b949e; }
                                        LineEdit { text <=> root.target-input; }
                                    }
                                    VerticalBox {
                                        spacing: 3px;
                                        Text { text: "Ports (top-100, top-1000, 80,443):"; font-size: 11px; color: #8b949e; }
                                        LineEdit { text <=> root.ports-input; }
                                    }
                                    VerticalBox {
                                        spacing: 3px;
                                        Text { text: "Timing:"; font-size: 11px; color: #8b949e; }
                                        HorizontalBox {
                                            spacing: 4px;
                                            Button { text: "T3"; clicked => { root.timing-level = 3; } }
                                            Button { text: "T4"; clicked => { root.timing-level = 4; } }
                                        }
                                    }
                                    VerticalBox {
                                        alignment: end;
                                        Button {
                                            text: "  Start Scan  ";
                                            clicked => { root.run-scan(root.target-input, root.ports-input, root.timing-level); }
                                        }
                                    }
                                }
                            }
                        }

                        // OS Match
                        Rectangle {
                            background: #161b22;
                            border-radius: 6px;
                            border-color: #30363d;
                            border-width: 1px;
                            VerticalBox {
                                padding: 10px;
                                spacing: 3px;
                                Text { text: "Operating System & Device Fingerprint (-O):"; font-size: 11px; font-weight: 700; color: #d2a8ff; }
                                Text { text: root.os-match-text; font-size: 12px; color: #c9d1d9; }
                            }
                        }

                        // Results Table
                        Rectangle {
                            background: #161b22;
                            border-radius: 6px;
                            border-color: #30363d;
                            border-width: 1px;
                            height: 350px;

                            VerticalBox {
                                padding: 10px;
                                spacing: 4px;
                                HorizontalBox {
                                    Text { text: "Port / Protocol"; width: 120px; font-size: 12px; font-weight: 700; color: #8b949e; }
                                    Text { text: "State"; width: 90px; font-size: 12px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Service"; width: 140px; font-size: 12px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Version / Detected Product / Banner"; font-size: 12px; font-weight: 700; color: #8b949e; }
                                }
                                Rectangle { height: 1px; background: #30363d; }
                                ListView {
                                    for port in root.scan-results: HorizontalBox {
                                        height: 26px;
                                        Text { text: port.port; width: 120px; font-size: 12px; color: #58a6ff; font-weight: 600; vertical-alignment: center; }
                                        Text { text: port.state; width: 90px; font-size: 12px; color: #3fb950; font-weight: 700; vertical-alignment: center; }
                                        Text { text: port.service; width: 140px; font-size: 12px; color: #f0f6fc; vertical-alignment: center; }
                                        Text { text: port.version; font-size: 12px; color: #c9d1d9; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }

                    // ==============================================================
                    // 4. TRACEROUTE TAB
                    // ==============================================================
                    if root.active-nav == "traceroute": VerticalBox {
                        spacing: 10px;
                        Text { text: "Nmap Hop-by-Hop Traceroute Engine"; font-size: 18px; font-weight: 700; color: #f0f6fc; }

                        HorizontalBox {
                            spacing: 10px;
                            LineEdit {
                                placeholder-text: "Target IP or hostname (e.g. 1.1.1.1, scanme.nmap.org)";
                                text <=> root.traceroute-target;
                            }
                            Button {
                                text: "Run Traceroute";
                                clicked => { root.run-traceroute(root.traceroute-target); }
                            }
                        }

                        Rectangle {
                            background: #161b22;
                            border-radius: 6px;
                            border-color: #30363d;
                            border-width: 1px;
                            height: 460px;

                            VerticalBox {
                                padding: 12px;
                                spacing: 6px;
                                HorizontalBox {
                                    Text { text: "Hop #"; width: 70px; font-size: 12px; font-weight: 700; color: #8b949e; }
                                    Text { text: "IP Address"; width: 180px; font-size: 12px; font-weight: 700; color: #8b949e; }
                                    Text { text: "RTT / Latency"; width: 120px; font-size: 12px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Hop Status / Target Resolution"; font-size: 12px; font-weight: 700; color: #8b949e; }
                                }
                                Rectangle { height: 1px; background: #30363d; }
                                ListView {
                                    for h in root.traceroute-list: HorizontalBox {
                                        height: 28px;
                                        Text { text: h.hop; width: 70px; font-size: 12px; color: #58a6ff; font-weight: 700; vertical-alignment: center; }
                                        Text { text: h.ip; width: 180px; font-size: 12px; color: #f0f6fc; vertical-alignment: center; }
                                        Text { text: h.rtt; width: 120px; font-size: 12px; color: #3fb950; vertical-alignment: center; }
                                        Text { text: h.status; font-size: 12px; color: #c9d1d9; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }

                    // ==============================================================
                    // 5. SECURITY AUDIT (NSE) TAB
                    // ==============================================================
                    if root.active-nav == "audit": VerticalBox {
                        spacing: 10px;
                        Text { text: "NETRA Scripting Engine (NSE) & Vulnerability Audit"; font-size: 18px; font-weight: 700; color: #f0f6fc; }

                        HorizontalBox {
                            spacing: 10px;
                            LineEdit {
                                placeholder-text: "Audit Target IP or Hostname (e.g. 127.0.0.1)";
                                text <=> root.audit-target;
                            }
                            Button {
                                text: "Launch Vulnerability Audit";
                                clicked => { root.run-audit(root.audit-target); }
                            }
                        }

                        Rectangle {
                            background: #161b22;
                            border-radius: 6px;
                            border-color: #30363d;
                            border-width: 1px;
                            height: 460px;

                            VerticalBox {
                                padding: 12px;
                                spacing: 6px;
                                HorizontalBox {
                                    Text { text: "Severity"; width: 90px; font-size: 12px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Vulnerability / Audit Title"; width: 340px; font-size: 12px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Port"; width: 60px; font-size: 12px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Description & Remediation"; font-size: 12px; font-weight: 700; color: #8b949e; }
                                }
                                Rectangle { height: 1px; background: #30363d; }
                                ListView {
                                    for v in root.vuln-list: VerticalBox {
                                        padding-top: 4px;
                                        padding-bottom: 4px;
                                        spacing: 2px;
                                        HorizontalBox {
                                            Text { text: v.severity; width: 90px; font-size: 12px; font-weight: 700; color: v.severity == "CRITICAL" ? #f85149 : (v.severity == "HIGH" ? #ff7b72 : #d29922); }
                                            Text { text: v.title; width: 340px; font-size: 12px; font-weight: 700; color: #f0f6fc; }
                                            Text { text: v.port; width: 60px; font-size: 12px; color: #58a6ff; }
                                            Text { text: v.description; font-size: 11px; color: #c9d1d9; }
                                        }
                                        Text { text: "  Remediation: " + v.remediation; font-size: 11px; color: #3fb950; }
                                        Rectangle { height: 1px; background: #21262d; }
                                    }
                                }
                            }
                        }
                    }

                    // ==============================================================
                    // 6. NETWORK INVENTORY & TOPOLOGY
                    // ==============================================================
                    if root.active-nav == "inventory": VerticalBox {
                        spacing: 10px;
                        Text { text: "Correlated Local Network Device Inventory"; font-size: 18px; font-weight: 700; color: #f0f6fc; }
                        Rectangle {
                            background: #161b22;
                            border-radius: 6px;
                            border-color: #30363d;
                            border-width: 1px;
                            height: 480px;

                            VerticalBox {
                                padding: 12px;
                                spacing: 6px;
                                HorizontalBox {
                                    Text { text: "IP Address"; width: 160px; font-size: 12px; font-weight: 700; color: #8b949e; }
                                    Text { text: "MAC Address"; width: 160px; font-size: 12px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Detected OS"; width: 200px; font-size: 12px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Open Services"; font-size: 12px; font-weight: 700; color: #8b949e; }
                                }
                                Rectangle { height: 1px; background: #30363d; }
                                ListView {
                                    for host in root.host-list: HorizontalBox {
                                        height: 28px;
                                        Text { text: host.ip; width: 160px; font-size: 12px; color: #58a6ff; font-weight: 600; vertical-alignment: center; }
                                        Text { text: host.mac; width: 160px; font-size: 12px; color: #c9d1d9; vertical-alignment: center; }
                                        Text { text: host.os; width: 200px; font-size: 12px; color: #d2a8ff; vertical-alignment: center; }
                                        Text { text: host.services; font-size: 12px; color: #3fb950; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }

                    // ==============================================================
                    // 7. TRAFFIC STATISTICS TAB
                    // ==============================================================
                    if root.active-nav == "stats": HorizontalBox {
                        spacing: 12px;

                        // Protocol Distribution
                        Rectangle {
                            width: 380px;
                            height: 500px;
                            background: #161b22;
                            border-radius: 6px;
                            border-color: #30363d;
                            border-width: 1px;
                            VerticalBox {
                                padding: 12px;
                                spacing: 6px;
                                Text { text: "Protocol Hierarchy Statistics"; font-size: 14px; font-weight: 700; color: #58a6ff; }
                                Rectangle { height: 1px; background: #30363d; }
                                ListView {
                                    for p in root.protocol-stats: HorizontalBox {
                                        height: 26px;
                                        Text { text: p.protocol; font-size: 12px; font-weight: 600; color: #f0f6fc; vertical-alignment: center; }
                                        Text { text: p.packets + " packets"; font-size: 12px; color: #3fb950; vertical-alignment: center; }
                                    }
                                }
                            }
                        }

                        // Conversations
                        Rectangle {
                            height: 500px;
                            background: #161b22;
                            border-radius: 6px;
                            border-color: #30363d;
                            border-width: 1px;
                            VerticalBox {
                                padding: 12px;
                                spacing: 6px;
                                Text { text: "IP Conversation Endpoints"; font-size: 14px; font-weight: 700; color: #3fb950; }
                                Rectangle { height: 1px; background: #30363d; }
                                HorizontalBox {
                                    Text { text: "Endpoint A"; width: 140px; font-size: 11px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Endpoint B"; width: 140px; font-size: 11px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Packets"; width: 80px; font-size: 11px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Bytes"; font-size: 11px; font-weight: 700; color: #8b949e; }
                                }
                                ListView {
                                    for conv in root.conversation-list: HorizontalBox {
                                        height: 26px;
                                        Text { text: conv.endpoint_a; width: 140px; font-size: 11px; color: #58a6ff; vertical-alignment: center; }
                                        Text { text: conv.endpoint_b; width: 140px; font-size: 11px; color: #f0f6fc; vertical-alignment: center; }
                                        Text { text: conv.packets; width: 80px; font-size: 11px; color: #c9d1d9; vertical-alignment: center; }
                                        Text { text: conv.bytes + " B"; font-size: 11px; color: #8b949e; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }

                    // ==============================================================
                    // 8. OVERVIEW DASHBOARD
                    // ==============================================================
                    if root.active-nav == "overview": VerticalBox {
                        spacing: 14px;
                        Text { text: "Unified Network Operations Dashboard"; font-size: 18px; font-weight: 700; color: #f0f6fc; }

                        HorizontalBox {
                            spacing: 14px;
                            Rectangle {
                                background: #161b22;
                                border-radius: 6px;
                                border-color: #30363d;
                                border-width: 1px;
                                height: 85px;
                                VerticalBox {
                                    padding: 10px;
                                    Text { text: "DISCOVERED HOSTS"; font-size: 11px; color: #8b949e; font-weight: 600; }
                                    Text { text: root.known-hosts-count; font-size: 22px; font-weight: 700; color: #58a6ff; }
                                }
                            }
                            Rectangle {
                                background: #161b22;
                                border-radius: 6px;
                                border-color: #30363d;
                                border-width: 1px;
                                height: 85px;
                                VerticalBox {
                                    padding: 10px;
                                    Text { text: "ANALYZED PACKETS"; font-size: 11px; color: #8b949e; font-weight: 600; }
                                    Text { text: root.total-packets-count; font-size: 22px; font-weight: 700; color: #3fb950; }
                                }
                            }
                            Rectangle {
                                background: #161b22;
                                border-radius: 6px;
                                border-color: #30363d;
                                border-width: 1px;
                                height: 85px;
                                VerticalBox {
                                    padding: 10px;
                                    Text { text: "STORAGE SUBSYSTEM"; font-size: 11px; color: #8b949e; font-weight: 600; }
                                    Text { text: "SQLite WAL"; font-size: 20px; font-weight: 700; color: #d2a8ff; }
                                }
                            }
                        }

                        Rectangle {
                            background: #161b22;
                            border-radius: 6px;
                            border-color: #30363d;
                            border-width: 1px;
                            VerticalBox {
                                padding: 14px;
                                spacing: 8px;
                                Text { text: "Wireshark & Nmap Unified Guarantees:"; font-size: 14px; font-weight: 700; color: #f0f6fc; }
                                Text { text: "✔ 100% Offline: Strictly zero telemetry, analytics, or background tracking."; font-size: 12px; color: #c9d1d9; }
                                Text { text: "✔ Wireshark Parity: 3-pane dissection, Expert Info, color coding, streaming PCAP/PCAPNG."; font-size: 12px; color: #c9d1d9; }
                                Text { text: "✔ Nmap Parity: Port scanner, timing templates T0-T5, OS fingerprinting -O, Traceroute, NSE."; font-size: 12px; color: #c9d1d9; }
                                Text { text: "✔ Portable Zero-Config: Run anywhere with SQLite WAL journaling and settings in-folder."; font-size: 12px; color: #c9d1d9; }
                            }
                        }
                    }

                    // ==============================================================
                    // 9. SETTINGS & PREFERENCES (ALL MINOR SETTINGS)
                    // ==============================================================
                    if root.active-nav == "settings": VerticalBox {
                        spacing: 10px;
                        Text { text: "Detailed Engine Settings & Preferences"; font-size: 18px; font-weight: 700; color: #f0f6fc; }

                        HorizontalBox {
                            spacing: 12px;

                            // Left Column: Wireshark Dissection Settings
                            Rectangle {
                                background: #161b22;
                                border-radius: 6px;
                                border-color: #30363d;
                                border-width: 1px;
                                VerticalBox {
                                    padding: 14px;
                                    spacing: 8px;
                                    Text { text: "Wireshark Dissection & Capture Settings:"; font-size: 13px; font-weight: 700; color: #58a6ff; }
                                    CheckBox { text: "Relative TCP sequence numbers (seq=0 on SYN)"; checked <=> root.setting-relative-seq; }
                                    CheckBox { text: "Verify packet checksums (IP/TCP/UDP)"; checked <=> root.setting-checksum; }
                                    CheckBox { text: "Reassemble out-of-order TCP streams"; checked <=> root.setting-tcp-reassembly; }
                                    CheckBox { text: "Desegment SSL / TLS application records"; checked <=> root.setting-desegment-ssl; }
                                    HorizontalBox {
                                        Text { text: "Snapshot Length (Snaplen):"; font-size: 12px; color: #8b949e; vertical-alignment: center; }
                                        LineEdit { text <=> root.setting-snaplen; width: 100px; }
                                    }
                                }
                            }

                            // Right Column: Nmap Scanner & Security Audit Settings
                            Rectangle {
                                background: #161b22;
                                border-radius: 6px;
                                border-color: #30363d;
                                border-width: 1px;
                                VerticalBox {
                                    padding: 14px;
                                    spacing: 8px;
                                    Text { text: "Nmap Scanner & NSE Audit Settings:"; font-size: 13px; font-weight: 700; color: #3fb950; }
                                    CheckBox { text: "Enforce 100% Offline Mode (No cloud calls)"; checked <=> root.setting-offline; }
                                    CheckBox { text: "Enable Anonymous FTP login audit"; checked <=> root.setting-audit-anon-ftp; }
                                    CheckBox { text: "Enable SMBv1 / MS17-010 EternalBlue probe"; checked <=> root.setting-audit-smb; }
                                    CheckBox { text: "Audit HTTP security headers & clickjacking"; checked <=> root.setting-audit-ciphers; }
                                    Button {
                                        text: "Save & Apply Settings";
                                        clicked => { root.save-settings(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Status Bar
        Rectangle {
            height: 28px;
            background: #161b22;
            border-width: 1px;
            border-color: #30363d;
            HorizontalBox {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;
                Text {
                    text: root.status-message;
                    font-size: 12px;
                    color: #8b949e;
                    vertical-alignment: center;
                }
                Text {
                    text: "NETRA Core 0.1.0 | Offline Guard Active";
                    font-size: 11px;
                    color: #8b949e;
                    vertical-alignment: center;
                }
            }
        }
    }
}
