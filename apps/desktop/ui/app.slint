import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView, ListView } from "std-widgets.slint";

export struct PacketItem {
    index: int,
    protocol: string,
    source: string,
    destination: string,
    length: int,
    summary: string,
}

export struct DissectedLayerItem {
    name: string,
    detail: string,
}

export struct ScannedPortItem {
    port: string,
    state: string,
    service: string,
    version: string,
}

export struct HostItem {
    ip: string,
    mac: string,
    os: string,
    services: string,
    packets: int,
}

export struct ConversationItem {
    endpoint_a: string,
    endpoint_b: string,
    packets: int,
    bytes: int,
}

export struct ProtocolStatItem {
    protocol: string,
    packets: int,
}

export component MainWindow inherits Window {
    title: "NETRA - Unified Network Intelligence, Packet Dissection & Scanning Platform";
    preferred-width: 1200px;
    preferred-height: 800px;
    background: #0d1117;
    default-font-family: "Segoe UI, sans-serif";

    in-out property <string> active-nav: "packets";
    in-out property <string> storage-mode: "Portable Mode (Active)";
    in-out property <string> status-message: "NETRA Core Online | 0 packets loaded";
    in-out property <int> known-hosts-count: 0;
    in-out property <int> total-packets-count: 0;
    in-out property <int> open-ports-count: 0;

    in-out property <string> filter-input: "";
    in-out property <string> target-input: "127.0.0.1";
    in-out property <string> ports-input: "top-100";
    in-out property <int> timing-level: 3;
    in-out property <int> selected-packet-index: 1;
    in-out property <string> hexdump-content: "Select a packet in the table above to view raw bytes.";
    in-out property <string> os-match-text: "No scan executed yet. Start an Nmap scan to detect OS & services.";

    in-out property <[PacketItem]> packet-list: [];
    in-out property <[DissectedLayerItem]> layer-list: [];
    in-out property <[ScannedPortItem]> scan-results: [];
    in-out property <[HostItem]> host-list: [];
    in-out property <[ConversationItem]> conversation-list: [];
    in-out property <[ProtocolStatItem]> protocol-stats: [];

    callback nav-changed(string);
    callback load-capture-file();
    callback apply-filter(string);
    callback select-packet(int);
    callback run-scan(string, string, int);
    callback run-discovery(string);
    callback refresh-stats();

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        // Header / Top Navigation Bar
        Rectangle {
            height: 56px;
            background: #161b22;
            HorizontalBox {
                padding-left: 20px;
                padding-right: 20px;
                alignment: space-between;

                HorizontalBox {
                    spacing: 14px;
                    Text {
                        text: "NETRA";
                        font-size: 20px;
                        font-weight: 800;
                        color: #58a6ff;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "|  Wireshark Dissection + Nmap Intelligence Engine (Rust)";
                        font-size: 13px;
                        color: #8b949e;
                        vertical-alignment: center;
                    }
                }

                HorizontalBox {
                    spacing: 16px;
                    Rectangle {
                        background: #1f2937;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #238636;
                        height: 28px;
                        HorizontalBox {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: root.storage-mode;
                                color: #3fb950;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Main Layout (Sidebar + Content Area)
        HorizontalBox {
            padding: 0px;
            spacing: 0px;

            // Sidebar
            Rectangle {
                width: 230px;
                background: #0d1117;
                border-width: 1px;
                border-color: #30363d;

                VerticalBox {
                    padding: 14px;
                    spacing: 8px;
                    alignment: start;

                    Button {
                        text: "  Packet Analyzer";
                        clicked => { root.active-nav = "packets"; root.nav-changed("packets"); }
                    }
                    Button {
                        text: "  Nmap Scanner";
                        clicked => { root.active-nav = "scanner"; root.nav-changed("scanner"); }
                    }
                    Button {
                        text: "  Network Inventory";
                        clicked => { root.active-nav = "inventory"; root.nav-changed("inventory"); }
                    }
                    Button {
                        text: "  Traffic Statistics";
                        clicked => { root.active-nav = "stats"; root.refresh-stats(); }
                    }
                    Button {
                        text: "  Overview Dashboard";
                        clicked => { root.active-nav = "overview"; root.nav-changed("overview"); }
                    }
                    Button {
                        text: "  Settings & Privacy";
                        clicked => { root.active-nav = "settings"; root.nav-changed("settings"); }
                    }
                }
            }

            // Content Body Area
            Rectangle {
                background: #090d13;
                VerticalBox {
                    padding: 16px;
                    spacing: 12px;

                    // ==============================================================
                    // 1. WIRESHARK 3-PANE PACKET ANALYZER
                    // ==============================================================
                    if root.active-nav == "packets": VerticalBox {
                        spacing: 10px;

                        // Wireshark Display Filter Bar
                        HorizontalBox {
                            spacing: 10px;
                            height: 36px;
                            LineEdit {
                                placeholder-text: "Apply a display filter ... (e.g. ip.src == 192.168.1.1, tcp.port == 80, dns, http, tls)";
                                text <=> root.filter-input;
                                accepted => { root.apply-filter(root.filter-input); }
                            }
                            Button {
                                text: "Apply Filter";
                                clicked => { root.apply-filter(root.filter-input); }
                            }
                            Button {
                                text: "Clear";
                                clicked => { root.filter-input = ""; root.apply-filter(""); }
                            }
                            Button {
                                text: "Open PCAP File";
                                clicked => { root.load-capture-file(); }
                            }
                        }

                        // PANE 1: Top Packet List Table
                        Rectangle {
                            background: #161b22;
                            border-radius: 4px;
                            border-color: #30363d;
                            border-width: 1px;
                            height: 240px;

                            VerticalBox {
                                padding: 8px;
                                spacing: 4px;
                                HorizontalBox {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    height: 20px;
                                    Text { text: "No."; width: 45px; font-size: 11px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Protocol"; width: 75px; font-size: 11px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Source"; width: 140px; font-size: 11px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Destination"; width: 140px; font-size: 11px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Length"; width: 60px; font-size: 11px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Info / Dissected Summary"; font-size: 11px; font-weight: 700; color: #8b949e; }
                                }
                                Rectangle { height: 1px; background: #30363d; }
                                ListView {
                                    for item in root.packet-list: Rectangle {
                                        height: 24px;
                                        background: item.index == root.selected-packet-index ? #1f2937 : transparent;
                                        border-radius: 3px;
                                        TouchArea {
                                            clicked => {
                                                root.selected-packet-index = item.index;
                                                root.select-packet(item.index);
                                            }
                                        }
                                        HorizontalBox {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            Text { text: item.index; width: 45px; font-size: 11px; color: #8b949e; vertical-alignment: center; }
                                            Text { text: item.protocol; width: 75px; font-size: 11px; font-weight: 700; color: #58a6ff; vertical-alignment: center; }
                                            Text { text: item.source; width: 140px; font-size: 11px; color: #f0f6fc; vertical-alignment: center; }
                                            Text { text: item.destination; width: 140px; font-size: 11px; color: #f0f6fc; vertical-alignment: center; }
                                            Text { text: item.length; width: 60px; font-size: 11px; color: #8b949e; vertical-alignment: center; }
                                            Text { text: item.summary; font-size: 11px; color: #c9d1d9; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }
                        }

                        // Bottom split: PANE 2 (Protocol Details Tree) + PANE 3 (Synchronized Hex Dump)
                        HorizontalBox {
                            spacing: 10px;

                            // PANE 2: Packet Details Tree
                            Rectangle {
                                width: 480px;
                                height: 260px;
                                background: #161b22;
                                border-radius: 4px;
                                border-color: #30363d;
                                border-width: 1px;
                                VerticalBox {
                                    padding: 8px;
                                    spacing: 4px;
                                    Text {
                                        text: "▸ Packet Protocol Dissection Tree";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #58a6ff;
                                    }
                                    Rectangle { height: 1px; background: #30363d; }
                                    ListView {
                                        for layer in root.layer-list: VerticalBox {
                                            padding-top: 4px;
                                            padding-bottom: 4px;
                                            spacing: 2px;
                                            Text {
                                                text: "▸ " + layer.name;
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: #79c0ff;
                                            }
                                            Text {
                                                text: "   " + layer.detail;
                                                font-size: 11px;
                                                color: #c9d1d9;
                                            }
                                        }
                                    }
                                }
                            }

                            // PANE 3: Hex & ASCII Dump View
                            Rectangle {
                                height: 260px;
                                background: #161b22;
                                border-radius: 4px;
                                border-color: #30363d;
                                border-width: 1px;
                                VerticalBox {
                                    padding: 8px;
                                    spacing: 4px;
                                    Text {
                                        text: "▸ Frame Hex & ASCII Byte Representation";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #3fb950;
                                    }
                                    Rectangle { height: 1px; background: #30363d; }
                                    ScrollView {
                                        Text {
                                            text: root.hexdump-content;
                                            font-family: "Consolas, Courier New, monospace";
                                            font-size: 11px;
                                            color: #c9d1d9;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ==============================================================
                    // 2. NMAP NETWORK SCANNER TAB
                    // ==============================================================
                    if root.active-nav == "scanner": VerticalBox {
                        spacing: 12px;

                        // Configuration Row
                        Rectangle {
                            background: #161b22;
                            border-radius: 6px;
                            border-color: #30363d;
                            border-width: 1px;

                            VerticalBox {
                                padding: 12px;
                                spacing: 10px;
                                HorizontalBox {
                                    spacing: 12px;
                                    VerticalBox {
                                        spacing: 4px;
                                        Text { text: "Target Specification (IP, Subnet, Hostname):"; font-size: 11px; color: #8b949e; }
                                        LineEdit {
                                            text <=> root.target-input;
                                            placeholder-text: "e.g. 127.0.0.1, 192.168.1.0/24, scanme.nmap.org";
                                        }
                                    }
                                    VerticalBox {
                                        spacing: 4px;
                                        Text { text: "Ports (top-100, top-1000, -p-, 80,443):"; font-size: 11px; color: #8b949e; }
                                        LineEdit {
                                            text <=> root.ports-input;
                                            placeholder-text: "top-100";
                                        }
                                    }
                                    VerticalBox {
                                        spacing: 4px;
                                        Text { text: "Timing Template:"; font-size: 11px; color: #8b949e; }
                                        HorizontalBox {
                                            spacing: 6px;
                                            Button { text: "T3 Normal"; clicked => { root.timing-level = 3; } }
                                            Button { text: "T4 Aggressive"; clicked => { root.timing-level = 4; } }
                                        }
                                    }
                                    VerticalBox {
                                        alignment: end;
                                        Button {
                                            text: "  Start Nmap Scan  ";
                                            clicked => { root.run-scan(root.target-input, root.ports-input, root.timing-level); }
                                        }
                                    }
                                }
                            }
                        }

                        // OS Match & Heuristic Banner
                        Rectangle {
                            background: #161b22;
                            border-radius: 6px;
                            border-color: #30363d;
                            border-width: 1px;
                            VerticalBox {
                                padding: 12px;
                                spacing: 4px;
                                Text { text: "Operating System & Device Fingerprint (-O):"; font-size: 12px; font-weight: 700; color: #d2a8ff; }
                                Text { text: root.os-match-text; font-size: 12px; color: #c9d1d9; }
                            }
                        }

                        // Results Table
                        Rectangle {
                            background: #161b22;
                            border-radius: 6px;
                            border-color: #30363d;
                            border-width: 1px;
                            height: 340px;

                            VerticalBox {
                                padding: 12px;
                                spacing: 6px;
                                HorizontalBox {
                                    Text { text: "Port / Protocol"; width: 120px; font-size: 12px; font-weight: 700; color: #8b949e; }
                                    Text { text: "State"; width: 90px; font-size: 12px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Service"; width: 140px; font-size: 12px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Version / Detected Product / Banner"; font-size: 12px; font-weight: 700; color: #8b949e; }
                                }
                                Rectangle { height: 1px; background: #30363d; }
                                ListView {
                                    for port in root.scan-results: HorizontalBox {
                                        height: 26px;
                                        Text { text: port.port; width: 120px; font-size: 12px; color: #58a6ff; font-weight: 600; vertical-alignment: center; }
                                        Text { text: port.state; width: 90px; font-size: 12px; color: #3fb950; font-weight: 700; vertical-alignment: center; }
                                        Text { text: port.service; width: 140px; font-size: 12px; color: #f0f6fc; vertical-alignment: center; }
                                        Text { text: port.version; font-size: 12px; color: #c9d1d9; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }

                    // ==============================================================
                    // 3. NETWORK INVENTORY & TOPOLOGY
                    // ==============================================================
                    if root.active-nav == "inventory": VerticalBox {
                        spacing: 12px;
                        Text { text: "Correlated Local Network Device Inventory"; font-size: 18px; font-weight: 700; color: #f0f6fc; }
                        Rectangle {
                            background: #161b22;
                            border-radius: 6px;
                            border-color: #30363d;
                            border-width: 1px;
                            height: 480px;

                            VerticalBox {
                                padding: 12px;
                                spacing: 6px;
                                HorizontalBox {
                                    Text { text: "IP Address"; width: 160px; font-size: 12px; font-weight: 700; color: #8b949e; }
                                    Text { text: "MAC Address"; width: 160px; font-size: 12px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Detected OS"; width: 200px; font-size: 12px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Open Services"; font-size: 12px; font-weight: 700; color: #8b949e; }
                                }
                                Rectangle { height: 1px; background: #30363d; }
                                ListView {
                                    for host in root.host-list: HorizontalBox {
                                        height: 28px;
                                        Text { text: host.ip; width: 160px; font-size: 12px; color: #58a6ff; font-weight: 600; vertical-alignment: center; }
                                        Text { text: host.mac; width: 160px; font-size: 12px; color: #c9d1d9; vertical-alignment: center; }
                                        Text { text: host.os; width: 200px; font-size: 12px; color: #d2a8ff; vertical-alignment: center; }
                                        Text { text: host.services; font-size: 12px; color: #3fb950; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }

                    // ==============================================================
                    // 4. TRAFFIC STATISTICS TAB
                    // ==============================================================
                    if root.active-nav == "stats": HorizontalBox {
                        spacing: 12px;

                        // Protocol Distribution
                        Rectangle {
                            width: 400px;
                            height: 500px;
                            background: #161b22;
                            border-radius: 6px;
                            border-color: #30363d;
                            border-width: 1px;
                            VerticalBox {
                                padding: 12px;
                                spacing: 6px;
                                Text { text: "Protocol Hierarchy Statistics"; font-size: 14px; font-weight: 700; color: #58a6ff; }
                                Rectangle { height: 1px; background: #30363d; }
                                ListView {
                                    for p in root.protocol-stats: HorizontalBox {
                                        height: 26px;
                                        Text { text: p.protocol; font-size: 12px; font-weight: 600; color: #f0f6fc; vertical-alignment: center; }
                                        Text { text: p.packets + " packets"; font-size: 12px; color: #3fb950; vertical-alignment: center; }
                                    }
                                }
                            }
                        }

                        // Conversations
                        Rectangle {
                            height: 500px;
                            background: #161b22;
                            border-radius: 6px;
                            border-color: #30363d;
                            border-width: 1px;
                            VerticalBox {
                                padding: 12px;
                                spacing: 6px;
                                Text { text: "IP Conversation Endpoints"; font-size: 14px; font-weight: 700; color: #3fb950; }
                                Rectangle { height: 1px; background: #30363d; }
                                HorizontalBox {
                                    Text { text: "Endpoint A"; width: 140px; font-size: 11px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Endpoint B"; width: 140px; font-size: 11px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Packets"; width: 80px; font-size: 11px; font-weight: 700; color: #8b949e; }
                                    Text { text: "Bytes"; font-size: 11px; font-weight: 700; color: #8b949e; }
                                }
                                ListView {
                                    for conv in root.conversation-list: HorizontalBox {
                                        height: 26px;
                                        Text { text: conv.endpoint_a; width: 140px; font-size: 11px; color: #58a6ff; vertical-alignment: center; }
                                        Text { text: conv.endpoint_b; width: 140px; font-size: 11px; color: #f0f6fc; vertical-alignment: center; }
                                        Text { text: conv.packets; width: 80px; font-size: 11px; color: #c9d1d9; vertical-alignment: center; }
                                        Text { text: conv.bytes + " B"; font-size: 11px; color: #8b949e; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }

                    // ==============================================================
                    // 5. OVERVIEW DASHBOARD
                    // ==============================================================
                    if root.active-nav == "overview": VerticalBox {
                        spacing: 16px;
                        Text {
                            text: "Unified Network Operations Dashboard";
                            font-size: 18px;
                            font-weight: 700;
                            color: #f0f6fc;
                        }

                        HorizontalBox {
                            spacing: 16px;
                            Rectangle {
                                background: #161b22;
                                border-radius: 6px;
                                border-color: #30363d;
                                border-width: 1px;
                                height: 90px;
                                VerticalBox {
                                    padding: 12px;
                                    Text { text: "DISCOVERED HOSTS"; font-size: 11px; color: #8b949e; font-weight: 600; }
                                    Text { text: root.known-hosts-count; font-size: 24px; font-weight: 700; color: #58a6ff; }
                                }
                            }
                            Rectangle {
                                background: #161b22;
                                border-radius: 6px;
                                border-color: #30363d;
                                border-width: 1px;
                                height: 90px;
                                VerticalBox {
                                    padding: 12px;
                                    Text { text: "ANALYZED PACKETS"; font-size: 11px; color: #8b949e; font-weight: 600; }
                                    Text { text: root.total-packets-count; font-size: 24px; font-weight: 700; color: #3fb950; }
                                }
                            }
                            Rectangle {
                                background: #161b22;
                                border-radius: 6px;
                                border-color: #30363d;
                                border-width: 1px;
                                height: 90px;
                                VerticalBox {
                                    padding: 12px;
                                    Text { text: "STORAGE SUBSYSTEM"; font-size: 11px; color: #8b949e; font-weight: 600; }
                                    Text { text: "SQLite WAL"; font-size: 20px; font-weight: 700; color: #d2a8ff; }
                                }
                            }
                        }

                        Rectangle {
                            background: #161b22;
                            border-radius: 6px;
                            border-color: #30363d;
                            border-width: 1px;
                            VerticalBox {
                                padding: 16px;
                                spacing: 8px;
                                Text { text: "Wireshark & Nmap Unified Engine Guarantees:"; font-size: 14px; font-weight: 700; color: #f0f6fc; }
                                Text { text: "✔ 100% Offline: Strictly zero telemetry, telemetry probes, or external vendor network calls."; font-size: 12px; color: #c9d1d9; }
                                Text { text: "✔ Bounded Memory: Incremental streaming PCAP/PCAPNG readers never load full capture dumps to RAM."; font-size: 12px; color: #c9d1d9; }
                                Text { text: "✔ High Performance: Zero-allocation zero-copy packet header slicing running at ~1.86M pps."; font-size: 12px; color: #c9d1d9; }
                                Text { text: "✔ Cross-Platform: 100% Rust architecture with Slint native GUI and Clap CLI."; font-size: 12px; color: #c9d1d9; }
                            }
                        }
                    }

                    // ==============================================================
                    // 6. SETTINGS & SYSTEM INFO
                    // ==============================================================
                    if root.active-nav == "settings": VerticalBox {
                        spacing: 12px;
                        Text { text: "Settings & System Information"; font-size: 18px; font-weight: 700; color: #f0f6fc; }
                        Rectangle {
                            background: #161b22;
                            border-radius: 6px;
                            border-color: #30363d;
                            border-width: 1px;
                            VerticalBox {
                                padding: 16px;
                                spacing: 8px;
                                Text { text: "Application: NETRA Platform v0.1.0"; color: #f0f6fc; font-weight: 700; }
                                Text { text: "License: Apache License 2.0 (Independent Rust Implementation)"; color: #8b949e; }
                                Text { text: "Telemetry Status: Permanently Disabled (Zero Telemetry)"; color: #3fb950; font-weight: 600; }
                                Text { text: "Update Checks: Disabled by Default"; color: #8b949e; }
                            }
                        }
                    }
                }
            }
        }

        // Status Bar
        Rectangle {
            height: 28px;
            background: #161b22;
            border-width: 1px;
            border-color: #30363d;
            HorizontalBox {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;
                Text {
                    text: root.status-message;
                    font-size: 12px;
                    color: #8b949e;
                    vertical-alignment: center;
                }
                Text {
                    text: "NETRA Core 0.1.0";
                    font-size: 11px;
                    color: #8b949e;
                    vertical-alignment: center;
                }
            }
        }
    }
}
